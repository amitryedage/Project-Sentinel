# Configure these in Vercel Environment Variables (never in a frontend bundle).
APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/DB?sslmode=require
# Schema setup locally uses DATABASE_URL_UNPOOLED from neon deploy.
API_KEY=replace-with-a-random-operator-key
SENTINEL_SIGNING_SECRET=replace-with-a-separate-random-signing-secret
AUTO_CREATE_SCHEMA=false
SEMANTIC_MODE=mock
RAZORPAY_MOCK=1
# Optional: configure hosted LLM and Razorpay test credentials when ready.
