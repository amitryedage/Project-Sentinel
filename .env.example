# Copy to .env and fill in. All values optional in dev (mock fallbacks apply).

# Database (SQLite by default for demo — see docs/adr/0001-sqlite-for-demo.md)
DATABASE_URL=sqlite:///./sentinel/data/sentinel.db

# Semantic engine mode: llm | mock  (mock = deterministic battery, for offline demo reliability)
SEMANTIC_MODE=mock

# LLM endpoint. Two flavors, inferred from the base URL:
#  - base ending in /v1  -> OpenAI-compatible (Groq, Gemini gateway, vLLM, Ollama /v1)
#  - otherwise           -> Ollama-native (uses think:false to keep reasoning models fast)
LLM_API_BASE=http://127.0.0.1:11434
LLM_API_KEY=
LLM_MODEL=gemma4:latest
# LLM guards: bounded timeout + bounded egress (attacker-sized traces are truncated)
LLM_TIMEOUT_S=15
LLM_MAX_INPUT_CHARS=12000
LLM_MAX_TOKENS=512

# Razorpay test mode (leave empty to use mock gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# 1 = use mock gateway client (no real API calls)
RAZORPAY_MOCK=1
# Gateway base URL (production default: https://api.razorpay.com/v1 — TLS).
# The local emulated endpoint (sentinel/tools/emulated_razorpay.py) is a TEST
# TOOL ONLY: point here only for the live-demo E2E (pitch/live_demo.py).
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Per-endpoint webhook secret (HMAC-SHA256 over the raw body). Empty = webhook
# receiver disabled (fail-closed 503). Set to enable the external evidence writer.
RAZORPAY_WEBHOOK_SECRET=

# Dispute export signing (Phase 4). The export's timestamp-authority
# signature is HMAC-SHA256 with this secret; it falls back to the API key
# when empty. In production set it OUT-OF-BAND so key-holders cannot also
# sign (see security_audit.md SEC-D2). Dispute auditors receive it out-of-
# band and verify exports with sentinel.api.routes.export.verify_signature.
SENTINEL_SIGNING_SECRET=

# App
APP_ENV=dev
